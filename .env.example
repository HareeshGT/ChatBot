# Local model is always available and is the default.
MODEL_REPO=Qwen/Qwen2.5-0.5B-Instruct-GGUF
MODEL_FILE=qwen2.5-0.5b-instruct-q4_k_m.gguf
DEFAULT_MODEL=local
LLAMA_THREADS=2
LLAMA_CONTEXT_SIZE=2048

# Optional hosted providers. Add only the providers you want to enable.
# Never put API keys in frontend JavaScript or commit real keys to Git.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Optional custom OpenAI-compatible endpoint/model.
CUSTOM_API_BASE=
CUSTOM_API_KEY=
CUSTOM_MODEL_NAME=
CUSTOM_MODEL_LABEL=Custom API model
